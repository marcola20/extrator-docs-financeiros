# Copie para .env e preencha. O .env é ignorado pelo git.
DATABASE_URL=postgresql+psycopg://extrator:extrator@localhost:5432/extrator

# Provedor de LLM: gemini (padrão) ou anthropic. Ver docs/adr/003.
LLM_PROVEDOR=gemini
# Vazio usa o modelo padrão do provedor (gemini-3.5-flash-lite).
# Para a comparação final: gemini-3.8-flash.
LLM_MODELO=

# Chave do provedor escolhido. Só a dele precisa estar preenchida.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Cota de requisições. Zero usa a cota de tabela do tier gratuito.
LLM_RPM=0
LLM_RPD=0
LLM_ARQUIVO_COTAS=dados/estado-cotas.json

# Cache de extrações em disco, para não gastar cota reexecutando eval igual.
# Invalidar com: uv run python -m app.llm.cache --limpar
LLM_CACHE_ATIVO=true
LLM_CACHE_DIRETORIO=dados/cache-llm
