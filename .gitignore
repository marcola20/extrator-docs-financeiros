# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Ferramentas
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Ambiente
.env

# Documentos reais NUNCA entram no repo.
# Apenas dados sintéticos versionados em dados/sinteticos/.
dados/*
!dados/.gitkeep
!dados/sinteticos/
!dados/real/

# dados/real/ é onde ficam documentos de verdade durante o teste local.
# Do que está ali, só a estrutura da pasta é versionada — o LEIA-ME e o
# .gitkeep. Todo documento colocado dentro fica de fora do git.
# A regra é conferida por tests/test_dados_reais_nao_versionados.py.
dados/real/*
!dados/real/LEIA-ME.md
!dados/real/boletos/
dados/real/boletos/*
!dados/real/boletos/.gitkeep

# Relatórios do eval: gerados por execução, com carimbo de data.
# Versionar um número medido é decisão consciente, não efeito colateral.
resultados/

# IDE / SO
.vscode/
.idea/
Thumbs.db
.DS_Store
